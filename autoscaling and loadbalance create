provider "aws" {
  region = "us-east-1"
}

# EC2 Launch Template
resource "aws_launch_template" "app" {
  name_prefix   = "my-app-"
  image_id      = "ami-0244c35c41029d9d1"
  instance_type = "t3.small"

  user_data = base64encode(<<-EOF
    #!/bin/bash
    apt update -y
    apt install nginx -y
    systemctl start nginx
    echo "Hello from EC2" > /var/www/html/index.html
  EOF
  )
}

# Auto Scaling Group
resource "aws_autoscaling_group" "app" {

  min_size         = 2
  max_size         = 4
  desired_capacity = 2

  vpc_zone_identifier = [
    "your subnet id example subnet-09bd4d189936b0a2f",
    "your subnet id example subnet-09bd4d189936b0a2f"
  ]

  launch_template {
    id      = aws_launch_template.app.id
    version = "$Latest"
  }
}

# Load Balancer
resource "aws_lb" "app" {

  name               = "my-load-balancer"
  load_balancer_type = "application"

  subnets = [
    "your subnet id example subnet-09bd4d189936b0a2f ",
    "your subnet id example subnet-09bd4d189936b0a2f"
  ]
}
