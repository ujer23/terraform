# Launch Template
resource "aws_launch_template" "app" {
  name_prefix   = "my-app-"
  image_id      = "ami-0244c35c41029d9d1"
  instance_type = "t3.small"

  user_data = base64encode(<<-EOF
    #!/bin/bash
    apt update -y
    apt install nginx -y
    systemctl enable nginx
    systemctl start nginx
    echo "Hello from EC2" > /var/www/html/index.html
  EOF
)
}

# Default VPC
resource "aws_default_vpc" "vpc2" {}

# Target Group
resource "aws_lb_target_group" "app" {
  name     = "my-target-group"
  port     = 80
  protocol = "HTTP"
  vpc_id   = "vpc-00dd1f6e270752612"
}

# Load Balancer
resource "aws_lb" "app" {
  name               = "my-load-balancer"
  load_balancer_type = "application"

  subnets = [
    "subnet-0eaed48c2e3ad9415",
    "subnet-013600e9aae206479"
  ]
}

# Listener
resource "aws_lb_listener" "app" {
  load_balancer_arn = aws_lb.app.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app.arn
  }
}

# Auto Scaling Group
resource "aws_autoscaling_group" "app" {
  min_size         = 1
  max_size         = 4
  desired_capacity = 2

  vpc_zone_identifier = [
    "subnet-0eaed48c2e3ad9415",
    "subnet-013600e9aae206479"
  ]

  target_group_arns = [
    aws_lb_target_group.app.arn
  ]

  launch_template {
    id      = aws_launch_template.app.id
    version = "$Latest"
  }
}
